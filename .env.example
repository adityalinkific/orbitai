# Database Configuration
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_password
POSTGRES_DB=orbit_db
DATABASE_URL=postgresql+asyncpg://orbit:orbit_password@localhost:5432/orbit_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application
APP_NAME=Orbit AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=200

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenAI (if using)
OPENAI_API_KEY=your-openai-api-key

# Email (if using)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@orbit.dev

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=True
